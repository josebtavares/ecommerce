{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/backend/clube/**"]
  },
  "deploy": {
    "startCommand": "sh start_worker.sh",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 60
  }
}
